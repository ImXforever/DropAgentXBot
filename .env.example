# === Telegram Bot ===
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=your_telegram_user_id_here

# === Hermes Engine ===
# auto = prefer local `hermes` CLI, then HERMES_GATEWAY_URL, then plain API
HERMES_MODE=auto
HERMES_CMD=hermes
HERMES_PROFILE=
HERMES_GATEWAY_URL=
HERMES_GATEWAY_TOKEN=
HERMES_TIMEOUT=180
HERMES_MAX_CONCURRENT=2

# === Fallback API backend (used when Hermes is not available) ===
AI_API_KEY=your_openrouter_or_openai_api_key_here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
# Optional dedicated OpenAI-compatible media provider for image/STT/TTS.
# OpenRouter remains text-only; set these to OpenAI or another compatible provider.
MEDIA_BASE_URL=
MEDIA_API_KEY=

# === Economy ===
COMMISSION_RATE=0.10
CREDITS_PER_FOLLOW=5
WELCOME_CREDITS=50

# === Referral program ===
REF_INVITE_BONUS_REFERRER=75   # paid when invitee does first task/purchase (Dropbox two-sided)
REF_BONUS_REFEREE=50           # bonus for the invited user (Coinbase-style gate)
REF_MYSTERY_MIN=5              # instant random box per signup (Robinhood)
REF_MYSTERY_MAX=20
REF_COMMISSION_SHARE=0.20      # lifetime share of platform commission (Binance)
REF_MS_5=250                   # milestone ladder (Tesla): 5 / 25 / 100 referrals
REF_MS_25=1500
REF_MS_100=8000

# === Org ranks (fractal autonomy) ===
CAPO_MIN_REFS=10        # qualified referrals to auto-become Capo
CAPO_OVERRIDE_PCT=0.05  # Capo's cut of platform commission on soldier sales

# === A2A / API Server ===
# If A2A_PORT is set, A2A_TOKEN is mandatory (fail-closed).
A2A_PORT=
A2A_TOKEN=

# === Web Dashboard + Storefront (optional) ===
# WEB_PORT on → storefront at / , admin panel at /admin
WEB_PORT=8080
WEB_HOST=0.0.0.0
WEB_PASSWORD=            # required for /admin login
WEB_SECRET=              # cookie signing secret (falls back to BOT_TOKEN)
BOT_USERNAME=            # your bot's t.me username (storefront CTA)

# === Long-term memory (optional) ===
# Pluggable provider layer; default sqlite (user_memories + user_profile tables)
MEMORY_PROVIDER=sqlite

# === Automatic daily backups (optional) ===
# Snapshot of the whole DB is sent to every ADMIN_IDS chat once a day.
BACKUP_TO_TELEGRAM=1      # 0 = only local data/backups/ copies
BACKUP_HOUR=4             # server hour (0-23) when the backup fires

# === Second gateway ===
# DISCORD_TOKEN is defined in the Discord section below.

# === MCP servers (optional) ===
# data/mcp_servers.json → [{"name":"fs","command":["npx","-y","@modelcontextprotocol/server-filesystem","/tmp"]}]

# === USDT Treasury ===
CREDITS_PER_USDT=1000
DEPOSIT_MIN_USDT=1
WITHDRAW_MIN_USDT=5
WALLET_TON=
WALLET_BSC=
WALLET_SOL=
WALLET_TRX=

# === Storage ===
DB_PATH=data/marketplace.db
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# === Runtime safety ===
APP_ENV=production
COOKIE_SECURE=1
APP_DEV_LOGIN=0
TREASURY_AUTO_ENABLED=0
TREASURY_POLL_SECONDS=60
CHAIN_CONFIRMATIONS=12

# === Chain verification (read-only) ===
# BSC/Base/Solana use JSON-RPC; never put private keys in this file.
BSC_RPC_URL=
BASE_RPC_URL=
SOL_RPC_URL=
TRONGRID_URL=https://api.trongrid.io
TRONGRID_API_KEY=
TON_INDEXER_URL=            # e.g. a normalized Tatum-style Jetton API base
TON_INDEXER_API_KEY=
USDT_BSC_TOKEN=
USDT_BASE_TOKEN=
USDT_SOL_TOKEN=
USDT_TRX_TOKEN=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_TON_TOKEN=
USDT_BSC_DECIMALS=6
USDT_BASE_DECIMALS=6
USDT_SOL_DECIMALS=6
USDT_TRX_DECIMALS=6
USDT_TON_DECIMALS=6
CONFIRMATIONS_BSC=12
CONFIRMATIONS_BASE=12
CONFIRMATIONS_SOL=32
CONFIRMATIONS_TRX=20
CONFIRMATIONS_TON=1

# === Automatic payouts ===
# External signer/service must support Idempotency-Key and return {ok:true,txid}.
PAYOUT_API_URL=
PAYOUT_API_TOKEN=

# === Discord ===
DISCORD_TOKEN=
